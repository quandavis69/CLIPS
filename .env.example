# Google Places API credentials, used to show live Google reviews on the
# homepage and Testimonials page (see src/lib/googleReviews.ts).
# Without these set, the site falls back to the hardcoded sample testimonials.
#
# 1. Create/select a project at https://console.cloud.google.com/
# 2. Enable "Places API (New)" for that project
# 3. Create an API key (APIs & Services > Credentials) and restrict it to
#    the Places API (New) only - this key is used server-side, so an
#    HTTP referrer restriction will NOT work; use an API restriction instead
#    and keep this value out of version control.
# 4. Find your Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Quote requests (from the Contact page form) are delivered by whichever of
# the two channels below is configured - both are tried on every submission
# (see src/app/api/quote-request/route.ts). Only if NEITHER is configured (or
# both fail) does the form fall back to opening the visitor's own email
# client, which requires them to manually hit send - unreliable, so at least
# one of these should be set in production.

# Twilio credentials used to text new quote requests straight to the
# business phone (see src/lib/twilio.ts).
#
# 1. Create a free account at https://www.twilio.com
# 2. Buy a phone number capable of sending SMS (Phone Numbers > Buy a number)
# 3. Find your Account SID and Auth Token on the Twilio console dashboard
# Note: a Twilio trial account can only send Twilio's own predefined
# templates, not custom message bodies like this one - the account must be
# upgraded (billing added) before SMS delivery will actually work.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Where quote requests get texted. Defaults to +15413058500 (541-305-8500)
# if left blank.
TWILIO_TO_NUMBER=

# Gmail SMTP credentials used to email new quote requests directly from the
# server (see src/lib/email.ts) - no third-party signup required beyond a
# Gmail account you already control.
#
# 1. Enable 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    (choose "Mail" as the app) - it's a 16-character code, not your normal
#    Gmail password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where quote request emails are sent. Defaults to
# michaelclipslawncare@gmail.com if left blank.
QUOTE_REQUEST_TO_EMAIL=
